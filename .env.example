# ============================================================
# Calendar Hub — Environment Variables
# ============================================================
# Copy to .env and edit values before deploying.
# For Coolify: set these in the resource's Environment Variables.

# ── Database ─────────────────────────────────────────
POSTGRES_USER=calendarhub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=calendarhub

# ── Backend ──────────────────────────────────────────
# IMPORTANT: Generate a strong secret for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-production

# Comma-separated list of allowed frontend origins (HTTPS in production)
CORS_ORIGINS=https://calendar.yourdomain.se

# ── Frontend ─────────────────────────────────────────
# IMPORTANT: This is the PUBLIC URL of the backend API.
# It gets baked into the frontend at build time.
# Must be reachable from the user's browser (not internal Docker URL).
VITE_API_URL=https://calendar-api.yourdomain.se

# ── Ports (local dev only — Coolify manages ports via proxy) ──
API_PORT=8000
FRONTEND_PORT=3000
